extends "res://tests/test_realm_playflow.gd"
## Spatial main UI: actual pointer navigation, fixed construction approval and isolated saves.

func _run() -> void:
	root.mode = Window.MODE_WINDOWED
	root.unresizable = true
	root.size = Vector2i(1280,720)
	await _fresh("office")
	await _shot("office_00_manor_720")
	await _click("NewRun")
	screen.draft_seed = 61427
	screen.guide_enabled = false
	await _click("PrepareNext")
	_check(_inside(_control("PrepareNext")),"region setup keeps next action fixed at 720p")
	await _shot("office_01_region_720")
	await _click("PrepareNext")
	await _click("StartRun")
	await _click("perk_"+str(screen.session.state.perk_offer[0]))
	_check(_visible("OfficeDesk") and not _visible("RealmBoard"),"office operations and district construction are separate spaces")
	for id in ["WorkcrewArea","WeekResult","OfficeConstruction","NextWeek"]: _check(_inside(_control(id)),"office essential area reachable: "+id)
	await _shot("office_02_study_720")
	await _click("nav_build")
	await _click("district_food")
	_check(screen.realm_board.size.x >= 700 and screen.realm_board.size.y >= 360,"district has usable scene space")
	await _click("lot_B13")
	for id in ["CloseLot","ProjectCosts","build_B13"]: _check(_inside(_control(id)),"fixed lot action reachable: "+id)
	await _shot("office_03_farm_720")
	await _click("build_B13")
	_check(screen.page == "estate" and screen.session.state.orders.count("B13") == 2,"approving the farm returns to weekly operations with the real reserved work")
	await _click("NextWeek")
	await _settle()
	_check(_inside(_control("TurnDetails")),"week result accessible without scrolling the operation panel")
	await _shot("office_04_result_720")
	await _click("TurnDetails")
	await _shot("office_05_receipt_720")
	await _click("CloseTurnDetails")
	await _click("MoreActions")
	await _shot("office_06_commands_720")
	await _click("nav_sanctuary")
	_check(screen.page == "sanctuary","sanctuary reached from the compact command menu")
	await _shot("office_07_sanctuary_720")
	await _click("nav_estate")
	root.size = Vector2i(1440,900)
	await _frames(10)
	await _shot("office_08_study_900")
	await _click("nav_build")
	await _click("district_civic")
	await _shot("office_09_village_900")
	await _click("AdjustWorkcrew")
	_check(screen.page == "estate" and _inside(_control("WorkcrewArea")),"construction labor shortcut returns to the actual office work crew")
	_check(root.size == Vector2i(1440,900),"actual 900p viewport preserved")
	await _finish()
